{"h":"\n<div style=\"font-family: 'Geist', system-ui, sans-serif; color: #0B2A4A; background: #FFFFFF; min-width: 0; overflow: hidden\">\n\n\n<!-- header -->\n<div style=\"background: linear-gradient(180deg, #DDF0FF 0%, #FFFFFF 100%)\">\n<div style=\"max-width: 1400px; margin: 0 auto; padding: 72px 32px 32px\">\n<div style=\"display: inline-block; background: #FFC93C; color: #0B2A4A; border-radius: 999px; padding: 7px 14px; font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.08em; margin-bottom: 20px\">FREE TOOL · NO SIGN-UP</div>\n<h1 style=\"font-family: 'Archivo', sans-serif; font-weight: 900; font-stretch: 110%; font-size: clamp(42px, 5.4vw, 80px); line-height: 0.98; letter-spacing: -0.03em; margin: 0 0 18px; max-width: 1000px\">CBM &amp; volumetric weight calculator</h1>\n<p style=\"font-size: 19px; line-height: 1.55; color: #17436B; max-width: 720px; margin: 0\">Enter your carton sizes to see total volume, air chargeable weight and how much of a container you'll use. Add as many box sizes as you need.</p>\n</div>\n</div>\n\n<!-- calculator -->\n<div style=\"max-width: 1400px; margin: 0 auto; padding: 24px 32px 80px; display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start\">\n\n<!-- inputs -->\n<div style=\"flex: 1.6 1 640px; min-width: 0; background: #FFFFFF; border: 1px solid #E1EDF7; border-radius: 28px; box-shadow: 0 20px 50px rgba(11,42,74,0.08); padding: 28px\">\n<div style=\"display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; justify-content: space-between; margin-bottom: 22px\">\n<div style=\"display: flex; align-items: center; gap: 10px; flex-wrap: wrap\">\n<span style=\"font-size: 14px; font-weight: 600; color: #3D5873\">Units</span>\n<div role=\"radiogroup\" aria-label=\"Dimension units\" style=\"display: inline-flex; background: #EEF6FD; border-radius: 999px; padding: 4px; gap: 4px\">\n<sc-for list=\"{{units}}\" as=\"u\" hint-placeholder-count=\"2\">\n<button role=\"radio\" aria-checked=\"{{u.on}}\" onClick=\"{{u.pick}}\" style=\"{{u.style}}\">{{u.label}}</button>\n</sc-for>\n</div>\n</div>\n<div style=\"display: flex; align-items: center; gap: 10px; flex-wrap: wrap\">\n<span style=\"font-size: 14px; font-weight: 600; color: #3D5873\">Air divisor</span>\n<div role=\"radiogroup\" aria-label=\"Volumetric divisor\" style=\"display: inline-flex; background: #EEF6FD; border-radius: 999px; padding: 4px; gap: 4px\">\n<sc-for list=\"{{divisors}}\" as=\"d\" hint-placeholder-count=\"2\">\n<button role=\"radio\" aria-checked=\"{{d.on}}\" onClick=\"{{d.pick}}\" style=\"{{d.style}}\">{{d.label}}</button>\n</sc-for>\n</div>\n</div>\n</div>\n\n<div style=\"overflow-x: auto\">\n<div style=\"min-width: 600px\">\n<div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr 0.8fr 1.1fr 44px; gap: 10px; padding: 0 0 8px; font-size: 12px; font-family: 'Geist Mono', monospace; letter-spacing: 0.06em; color: #5E7891\">\n<span>LENGTH ({{unitLabel}})</span><span>WIDTH ({{unitLabel}})</span><span>HEIGHT ({{unitLabel}})</span><span>PIECES</span><span>KG PER PIECE</span><span></span>\n</div>\n<sc-for list=\"{{rows}}\" as=\"r\" hint-placeholder-count=\"1\">\n<div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr 0.8fr 1.1fr 44px; gap: 10px; margin-bottom: 10px; align-items: center\">\n<input type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\" aria-label=\"Length\" value=\"{{r.l}}\" onChange=\"{{r.setL}}\" style=\"padding: 13px 12px; border: 1px solid #C9DCEC; border-radius: 12px; font-size: 16px; color: #0B2A4A; min-width: 0\">\n<input type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\" aria-label=\"Width\" value=\"{{r.w}}\" onChange=\"{{r.setW}}\" style=\"padding: 13px 12px; border: 1px solid #C9DCEC; border-radius: 12px; font-size: 16px; color: #0B2A4A; min-width: 0\">\n<input type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\" aria-label=\"Height\" value=\"{{r.h}}\" onChange=\"{{r.setH}}\" style=\"padding: 13px 12px; border: 1px solid #C9DCEC; border-radius: 12px; font-size: 16px; color: #0B2A4A; min-width: 0\">\n<input type=\"number\" min=\"0\" step=\"1\" inputmode=\"numeric\" aria-label=\"Pieces\" value=\"{{r.pcs}}\" onChange=\"{{r.setPcs}}\" style=\"padding: 13px 12px; border: 1px solid #C9DCEC; border-radius: 12px; font-size: 16px; color: #0B2A4A; min-width: 0\">\n<input type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\" aria-label=\"Weight per piece in kg\" value=\"{{r.kg}}\" onChange=\"{{r.setKg}}\" style=\"padding: 13px 12px; border: 1px solid #C9DCEC; border-radius: 12px; font-size: 16px; color: #0B2A4A; min-width: 0\">\n<button onClick=\"{{r.remove}}\" aria-label=\"Remove this line\" disabled=\"{{r.only}}\" style=\"width: 44px; height: 44px; border-radius: 12px; border: 1px solid #E1EDF7; background: #FFFFFF; color: #5E7891; font-size: 20px; cursor: pointer\">×</button>\n</div>\n<div style=\"font-size: 13px; color: #5E7891; margin: -4px 0 12px 2px\">Line {{r.n}}: {{r.cbm}} m³ · {{r.vol}} kg volumetric · {{r.gross}} kg gross</div>\n</sc-for>\n</div>\n</div>\n\n<div style=\"display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px\">\n<button onClick=\"{{addRow}}\" style=\"background: #EEF6FD; color: #0A6CC2; border: 0; border-radius: 999px; padding: 12px 20px; font-weight: 600; font-size: 15px; cursor: pointer\">+ Add another box size</button>\n<button onClick=\"{{reset}}\" style=\"background: transparent; color: #5E7891; border: 1px solid #E1EDF7; border-radius: 999px; padding: 11px 18px; font-size: 15px; cursor: pointer\">Reset</button>\n</div>\n</div>\n\n<!-- results -->\n<div style=\"flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 14px\">\n<div style=\"background: #0A6CC2; color: #FFFFFF; border-radius: 28px; padding: 28px\">\n<div style=\"font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: #FFC93C; margin-bottom: 6px\">AIR · CHARGEABLE WEIGHT</div>\n<div style=\"font-family: 'Archivo', sans-serif; font-weight: 900; font-stretch: 110%; font-size: 64px; line-height: 1\">{{chargeable}} <span style=\"font-size: 26px\">kg</span></div>\n<div style=\"font-size: 15px; color: #DCEEFC; margin-top: 10px\">{{basis}}</div>\n<div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 20px\">\n<div style=\"background: rgba(255,255,255,0.12); border-radius: 16px; padding: 14px\"><div style=\"font-size: 12px; color: #DCEEFC\">Volumetric weight</div><div style=\"font-weight: 600; font-size: 20px; margin-top: 4px\">{{volTotal}} kg</div></div>\n<div style=\"background: rgba(255,255,255,0.12); border-radius: 16px; padding: 14px\"><div style=\"font-size: 12px; color: #DCEEFC\">Gross weight</div><div style=\"font-weight: 600; font-size: 20px; margin-top: 4px\">{{grossTotal}} kg</div></div>\n</div>\n</div>\n\n<div style=\"background: #F2F8FD; border-radius: 28px; padding: 28px\">\n<div style=\"font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: #0A6CC2; margin-bottom: 6px\">SEA · TOTAL VOLUME</div>\n<div style=\"font-family: 'Archivo', sans-serif; font-weight: 900; font-stretch: 110%; font-size: 52px; line-height: 1\">{{cbmTotal}} <span style=\"font-size: 22px\">m³</span></div>\n<div style=\"font-size: 15px; color: #3D5873; margin-top: 10px\">{{pcsTotal}} pieces · {{cft}} cu ft · LCL billed on <strong>{{wm}} W/M</strong></div>\n<div style=\"margin-top: 20px; display: flex; flex-direction: column; gap: 12px\">\n<sc-for list=\"{{fits}}\" as=\"f\" hint-placeholder-count=\"3\">\n<div>\n<div style=\"display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px\"><span style=\"font-weight: 600\">{{f.name}}</span><span style=\"color: #3D5873\">{{f.text}}</span></div>\n<div style=\"height: 10px; background: #DCEAF6; border-radius: 999px; overflow: hidden\"><div style=\"{{f.bar}}\"></div></div>\n</div>\n</sc-for>\n</div>\n<div style=\"font-size: 12px; color: #5E7891; margin-top: 12px\">Based on practical loadable volume (about 28 / 58 / 68 m³). Real fit depends on box shapes and stacking.</div>\n<a href=\"{{planHref}}\" style=\"display: inline-flex; margin-top: 16px; background: #FFC93C; color: #0B2A4A; padding: 13px 22px; border-radius: 999px; font-weight: 600; text-decoration: none\">🧊 Plan the loading in 3D →</a>\n</div>\n\n<div style=\"background: #FFF8E6; border-radius: 28px; padding: 24px 28px; display: flex; flex-direction: column; gap: 12px\">\n<div style=\"font-family: 'Archivo', sans-serif; font-weight: 800; font-stretch: 106%; font-size: 20px\">Want a rate for this shipment?</div>\n<div style=\"font-size: 15px; color: #4A4030\">Send us these numbers and a licensed broker will reply within 2 working hours.</div>\n<div style=\"display: flex; flex-wrap: wrap; gap: 10px\">\n<a class=\"go\" href=\"contact.html\" style=\"background: #0A6CC2; color: #FFFFFF; padding: 13px 22px; border-radius: 999px; font-weight: 600; text-decoration: none\">Get a quote →</a>\n<a href=\"https://wa.me/message/6YB7I76DV6UJL1\" style=\"background: #25D366; color: #06331A; padding: 13px 22px; border-radius: 999px; font-weight: 600; text-decoration: none\">Send on WhatsApp</a>\n</div>\n</div>\n</div>\n</div>\n\n<!-- explainer for SEO -->\n<div style=\"background: #F2F8FD\">\n<div style=\"max-width: 1000px; margin: 0 auto; padding: 88px 32px\">\n<h2 style=\"font-family: 'Archivo', sans-serif; font-weight: 900; font-stretch: 110%; font-size: clamp(34px, 4vw, 52px); line-height: 1.02; letter-spacing: -0.03em; margin: 0 0 28px\">How it's calculated</h2>\n<sc-for list=\"{{faqs}}\" as=\"q\" hint-placeholder-count=\"5\">\n<details style=\"background: #FFFFFF; border-radius: 16px; padding: 20px 24px; margin-bottom: 10px\">\n<summary style=\"font-weight: 600; font-size: 18px; display: flex; justify-content: space-between; gap: 20px\">{{q.q}}<span style=\"color: #0A6CC2\">+</span></summary>\n<p style=\"font-size: 16px; line-height: 1.65; color: #3D5873; margin: 12px 0 0; white-space: pre-line\">{{q.a}}</p>\n</details>\n</sc-for>\n</div>\n</div>\n\n</div>\n"}